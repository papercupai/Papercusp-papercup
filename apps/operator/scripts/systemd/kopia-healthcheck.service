[Unit]
Description=Kopia healthcheck — alert if no recent snapshot
RequiresMountsFor=/mnt/cold-a/Backup/db-dumps

[Service]
Type=oneshot
# The healthcheck asserts dump-content freshness and Kopia source coverage. Keep
# it on the cold-a destination and require that mount before reading the tree.
# ⚠ KEEP IN SYNC with papercusp-db-backup.service, which sets the same var.
Environment=PAPERCUSP_HOST_PG_DUMP_DIR=/mnt/cold-a/Backup/db-dumps
ExecStart=%h/.config/kopia/healthcheck.sh

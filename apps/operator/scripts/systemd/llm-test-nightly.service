[Unit]
Description=Papercusp LLM testing — nightly suite run
# Deliberately stays a systemd timer, NOT a DBOS scheduled workflow
# (dbos-scheduler-consolidation-2026-06-03 P-010 / D-004): this is a heavy
# external test-suite runner (needs ANTHROPIC_API_KEY, ~90min, full LLM
# scenario tier) — CI-shaped work, not operator-process maintenance. DBOS
# owns operator maintenance jobs; this stays infra.
After=network-online.target
# Don't fire while the laptop's resuming from sleep — give the
# operator a moment to come back.
After=suspend.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Bound the run — the suite shouldn't take more than 90 minutes
# even with all matrix repeats. Fail open if it does so the
# next night isn't blocked.
TimeoutStartSec=90min
# REQUIRED: the user must provide their key here (or in
# ~/.config/environment.d/) — without it the script no-ops.
# Environment=ANTHROPIC_API_KEY=...
# Run from an immutable per-invocation snapshot: a shared-tree edit mid-run cannot
# corrupt it (papercusp-script-snapshot.sh; census in systemd-script-snapshot.test.ts).
# The script otherwise derives the repo root from its own (snapshot) directory.
Environment=PAPERCUSP_REPO_ROOT=%h/papercupai-workspace/papercusp
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/scripts/llm-test-nightly.sh

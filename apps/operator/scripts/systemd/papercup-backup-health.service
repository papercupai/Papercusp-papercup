[Unit]
Description=Papercusp DB-backup freshness + failure probe (EI-10733)
Documentation=https://github.com/papercusp/papercup/blob/main/apps/operator/scripts/systemd/README.md
After=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Keep this probe pointed at the same cold-a destination as the producer. A
# systemd user unit has no interactive-shell environment, so the per-unit value
# remains explicit even though the script fallback and environment.d agree.
Environment=PAPERCUSP_HOST_PG_DUMP_DIR=/mnt/cold-a/Backup/db-dumps
# Detection + escalation ONLY — never re-runs a dump, kills a process, or edits backup
# config (EI-8901: a health check must not hold mutate authority over what it judges).
# Snapshot the health probe and its adjacent lib/*.sh sidecars before starting;
# the probe may run while the shared checkout is edited (EI-22458080342999427).
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/scripts/papercup-backup-health-check.sh

# papercup-embed-sidecar-watchdog.service — WI-4021 (su-efc53, 2026-07-11);
# startup grace, non-blocking restart and consecutive-failure threshold added
# by EI-25222670171204378 (2026-10-06).
#
# Oneshot fired by papercup-embed-sidecar-watchdog.timer (60s cadence). The
# probe logic lives in papercup-embed-sidecar-watchdog.sh beside this unit so
# it can be exercised with stubs; read that file's header for the rules. In
# short: /healthz can stay green while the worker is wedged, so the script
# exercises the real /embed path (cache bypassed, exact accounting required);
# it skips a unit that is not yet active or is inside its startup grace, defers
# when /healthz proves a saturated live queue, and restarts (without blocking
# on the start job) only after consecutive failed probes.
#
# Run through papercusp-script-snapshot.sh so an edit to the script that lands
# while a probe is running cannot change the program mid-read.
[Unit]
Description=Papercusp embed-sidecar worker probe (restart on failed /embed)

[Service]
Type=oneshot
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercup-embed-sidecar-watchdog.sh

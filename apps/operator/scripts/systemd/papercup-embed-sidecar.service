# papercup-embed-sidecar.service — WI-4021 (su-efc53, 2026-07-11)
#
# The ONE supervised owner of the shared embedding sidecar (127.0.0.1:3384,
# gemma + harrier). Before this unit the sidecar was lazily spawned by
# whichever process first embedded (embed-sidecar-spawn.ts): unsupervised,
# tsx-run (~400% CPU loader overhead, WI-3829 class), died with its parent,
# and port-raced sibling spawners (EADDRINUSE → adopt → stall → in-process
# failover flap = the 2026-07-11 "mem0 down" incident).
#
# TREE: STAGING (%h/papercupai-workspace/papercusp) — the
# papercup-bg-host precedent (WI-3336); embedding vectors are tree-independent
# (D-002: same model, same prompts, same runtime). The entry is esbuild-bundled
# on EVERY start (no tsx loader) into dist-sidecar/ — its OWN outdir, because
# bundle-host.sh rm-rf's + recopies blueprint/sql assets into the outdir and
# must never race dev-api's dist-host/.
#
# Since WI-4021 clients REQUIRE the sidecar (the in-process fallback is
# retired), so this unit NEVER gives up: Restart=always with exponential
# backoff 2s→60s (RestartSteps, systemd 255) and StartLimitIntervalSec=0.
# EMBED_SIDECAR_WARM warms harrier (the live embedder mode) at boot too —
# a lazily-loaded model turned every restart into a first-embed timeout.
#
# ...and `rerank` for the SAME reason (EI-19380773834961669). The boot-warm
# RERANKER set is parsed from this SAME env and defaults to NONE — a host opts
# in, "because a reranker is only useful to hosts that actually serve search"
# (embed-sidecar-server.ts:300-306). THIS host serves search, so omitting the
# token left the ~150M cross-encoder (Alibaba-NLP/gte-reranker-modernbert-base)
# cold across every restart. Nothing errors — rerankers lazy-build on first
# request (the `rerankers` get-or-build Map, embed-sidecar-server.ts:439-455) —
# so the load is silently paid inside the FIRST caller's request budget, and
# sidecar-reranker.ts allows 15s over 3 attempts in ONE budget. A cold load can
# blow that and surface as "sidecar sickness" rather than "model wasn't warm".
# embed-sidecar-server.ts:88 called this exact shot when /rerank shipped ("The
# same argument applies to a reranker on a host that serves search"); the unit
# just never got the token.
#
# ⚠ A rerank BENCHMARK against a freshly-restarted sidecar must still issue a
# throwaway /rerank before timing if this token is ever removed — otherwise the
# first sample measures model load, not rerank.
#
# Companion: papercup-embed-sidecar-watchdog.timer probes POST /embed every 60s
# with cache bypass enabled and validates the returned vector + per-request
# inference accounting. A health-only probe can stay green while the worker
# thread is wedged, the exact failure this unit must detect under pressure.
#
# ROLLBACK: systemctl --user disable --now papercup-embed-sidecar
# papercup-embed-sidecar-watchdog.timer && systemctl --user daemon-reload.
# (Hosts with PAPERCUSP_EMBED_SIDECAR=1 spawn-or-adopt can own the port again,
# but note the client fallback retirement ships independently in code.)
[Unit]
Description=Papercusp shared embedding sidecar (:3384, gemma+harrier+rerank)
# EI-19381535849234617: StartLimitIntervalSec is a [Unit] directive — it was
# sitting in [Service] below, where systemd parses it, warns
# ("Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring"),
# and IGNORES it, leaving the default 10s/5-burst rate limiter armed. With
# RestartSec=2 that lets 5 fast-failing restarts (a bad bundle, a held port, an
# ExecStartPre esbuild failure) exhaust the limit in ~8-10s and drop the unit
# into `failed`, where Restart=always no longer applies — and the companion
# watchdog's `systemctl restart` on a wedged /healthz cannot clear a
# start-limit failure either. Clients have required this sidecar since WI-4021
# (the in-process fallback is retired), so that failure mode is not a
# degradation, it's an outage. Placing it here is what actually disables the
# rate limiter (StartLimitIntervalSec=0 in [Unit]) and restores the "NEVER
# gives up" property [Service]'s Restart=always/RestartSteps below describe.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/papercupai-workspace/papercusp/apps/operator
# node + npx (for ExecStartPre's esbuild) — systemd user PATH lacks linuxbrew
# (same fix as bg-host's 50-spawn-node-path.conf).
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PAPERCUSP_EMBED_SIDECAR_PORT=3384
Environment=PAPERCUSP_EMBED_SIDECAR_WARM=gemma,harrier,rerank
# Anti-recursion belt: a sidecar process must never spawn sidecars.
Environment=PAPERCUSP_EMBED_SIDECAR_MODE=1
# This managed sidecar serves the native-PG operators. A desktop's mutable
# embedded-PG discovery file must not redirect its durable admission ledger.
# Explicit database URL / PG-port configuration still takes precedence.
Environment=PAPERCUSP_SKIP_PG_DISCOVERY=1
# GPU cross-encoder reranking (plan on-demand-local-inference-lifecycle-2026-08-17, P-004).
#
# OPT-IN by design — the engine never auto-selects a GPU, because a GPU that is
# PRESENT is not a GPU that is USABLE: this box had an RTX 3090, the CUDA 12
# runtime and ORT's CUDA provider, and still could not execute on it for months
# because cuDNN 9 was absent (EI-19320976824112874). Anything that keyed off
# `nvidia-smi finding a card` would have selected the GPU here and silently
# turned every search into unreranked retrieval order.
#
# SAFE to leave set even when the GPU is busy, absent, or broken. A CUDA session
# that will not construct is demoted to the cpu/q8 PAIR (both fields together —
# never fp16-on-CPU, which is worse than either whole) and reranking continues.
# So this is opportunistic acceleration, never a hard dependency.
#
# Measured 2026-08-17 on the 3090: quality model gte-reranker-modernbert-base at
# 1.47 ms/pair cuda/fp16 vs 40.07 ms/pair cpu/q8 — 27x. Top-6 SET identical
# between the two arms; only ranks 5/6 transpose (a q8-vs-fp16 quantisation
# signature, cf. D-006). P@10 is a set metric, so the adopted surfaces'
# measured gains are expected to carry over unchanged.
#
# ⚠ DO NOT read this line as proof the GPU is in use. It records what was
# REQUESTED. Verify what is ACTUALLY running:
#     curl -s localhost:3384/healthz | jq .rerankExecution
Environment=PAPERCUSP_RERANK_DEVICE=cuda
# EMBEDDINGS on the GPU (plan memory-reduction-2026-09-24, P-008 / D-003).
# `auto` is the default and is spelled out only so the choice is visible here:
# CUDA when the CUDA execution provider is installed beside onnxruntime-node
# AND the NVIDIA driver is loaded, else CPU; a CUDA session that will not
# construct (or a forward pass that fails on the GPU) falls back to the CPU with
# the cause recorded. `gpu` / `cpu` force a device. Weights (dtype) are NOT
# changed — only the device — so stored vectors stay comparable (CPU vs CUDA
# cosine 0.9999999, measured 2026-09-24). Verify what actually runs:
#     curl -s localhost:3384/healthz | jq '.embedExecution, .embedExecutionHealth.demotion'
Environment=PAPERCUSP_EMBED_DEVICE=auto
# glibc otherwise grows up to 8×cores malloc arenas for the ORT/worker threads,
# which holds freed native memory as RSS (memory audit WI-10002858, F5).
Environment=MALLOC_ARENA_MAX=2
# WI-10006398: bundle-host.sh runs from a frozen snapshot (papercusp-script-snapshot.sh) so an
# edit landing mid-build cannot change the program bash is reading. From the snapshot it cannot
# find the checkout by its own path, so the checkout is pinned; bundle-host.sh honours the pin
# only when it runs from a snapshot.
Environment=BUNDLE_HOST_OPERATOR_DIR=%h/papercupai-workspace/papercusp/apps/operator
ExecStartPre=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/bin/bundle-host.sh bin/embed-sidecar.ts dist-sidecar/embed-sidecar.mjs
ExecStart=/usr/bin/bash -c 'exec node dist-sidecar/embed-sidecar.mjs'
Restart=always
RestartSec=2
RestartSteps=6
RestartMaxDelaySec=60
# ExecStartPre's esbuild can take ~1-2min on a loaded host.
TimeoutStartSec=300
TimeoutStopSec=10
CPUQuota=800%
CPUWeight=1500
MemoryAccounting=yes
MemoryHigh=8G
MemoryMax=12G
MemorySwapMax=0
# Treat a cgroup memory-limit event as one failed sidecar instance so
# Restart=always can replace it; do not leave a partially alive worker serving
# requests after the OOM killer has interrupted its model allocation.
OOMPolicy=kill

[Install]
WantedBy=default.target

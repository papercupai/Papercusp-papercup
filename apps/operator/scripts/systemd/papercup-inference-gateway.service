[Unit]
# The hive inference gateway (hive-inference-gateway-2026-06-09 P-013): a localhost transparent
# /v1/* proxy that PACES the fleet's bees through one bound Claude account + injects its OAuth.
# Bees point ANTHROPIC_BASE_URL at it, so it FAILS CLOSED — if this unit is down their requests
# get connection-refused (they wait/retry) rather than silently bursting direct to Anthropic.
# A long-lived localhost service, NOT a DBOS workflow (it must outlive any operator turn).
Description=Papercusp hive inference gateway — paced OAuth egress for the bee fleet
After=network-online.target
After=suspend.target

[Service]
Type=simple
WorkingDirectory=%h/papercupai-workspace/papercusp
# node/npx on PATH (linuxbrew + local). Adjust to the host's node if relocated.
Environment="PATH=/home/linuxbrew/.linuxbrew/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PAPERCUSP_INTEGRATION_ROOT=%h/papercupai-workspace/papercusp"
Environment="PAPERCUSP_GATEWAY_PORT=8788"
Environment="HARNESS_ADMIN_DATABASE_URL=postgresql://harness_admin:harness_admin_pwd@localhost:5432/papercusp"
# EXTENDED POST-ADMISSION ABSORPTION: on a slot-hold-deadline shed, release the admission slot (no slot held
# during the wait → cannot wedge) + re-acquire, holding the caller through a TRANSIENT throttle up to this many
# ms instead of 429ing. 0 = OFF (code default). 120000 (2 min) keeps worst-case hold (pre-admission 4 min + this)
# under the bee CLI's ~10-min SDK timeout. (On the dev box this is set via the .service.d/absorb.conf drop-in.)
Environment="PAPERCUSP_GATEWAY_REQUEST_ABSORB_MS=120000"
# Optional: pin a pool account; else the sole pool account or the box's ~/.claude login is used.
# Environment="PAPERCUSP_ACCOUNT_ID=acct-main"
# RETIRED: PAPERCUSP_GATEWAY_CONCURRENCY is read by nothing. Do not reinstate a numeric ceiling here.
# Admission concurrency is LEARNED per provider lane from measured outcomes and has a floor but no
# maximum (capless-inference-gateway-2026-08-28 P-010/P-012). Setting this variable changes no
# admission decision on any deployment path; the gateway logs a loud warning if it is present.
ExecStart=/usr/bin/env npx tsx packages/operator-core/lib/inference-gateway/bin.ts
# Fail CLOSED: always restart so the egress path is never silently absent.
Restart=always
RestartSec=2
Nice=5
# Graceful drain on stop/redeploy.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target

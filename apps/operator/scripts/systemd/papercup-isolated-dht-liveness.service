[Unit]
Description=Papercusp isolated-DHT liveness probe — real 2-swarm hyperswarm connect check for the silent-wedge class (EI-8892)
# Detection + escalation ONLY — this unit never restarts papercup-isolated-dht.service
# (EI-8901 boot-grace lesson: a restart-authority health check on a signal that spans
# process restarts risks a restart-storm on a freshly-restarted unit). Deliberately a
# systemd timer, NOT a DBOS scheduled workflow / in-process operator tick
# (dbos-scheduler-consolidation-2026-06-03 D-004 / EI-1622): this is a dev-box P2P
# infra probe, not product state. Mirrors papercup-webkit-reaper.service /
# papercup-perf-signals-capture.service.
After=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The probe itself has its own ~15s connect timeout + a 5s teardown budget, and
# the wrapper's outer backstop is already (timeout/1000)+45 = 60s. The cross-host
# leg adds an ssh preflight (<=8s) plus staging on the far side, so 60s here would
# kill the unit MID-PROBE and render as a hang rather than a verdict.
TimeoutStartSec=150
# ── cross-host leg (P-302) ────────────────────────────────────────────────────
# Local-only cannot see a MACHINE-BOUNDARY transport failure: it connects two
# processes on this host, which stays green while no other machine can reach the
# DHT at all. That blind spot is exactly the P-302 class, so point the dialling
# leg at the Mac rig.
#
# BEST-EFFORT ON PURPOSE (DHT_REMOTE_OPTIONAL=1, the default): the remote is a
# LAPTOP. In cross-host mode the dialling leg runs THERE, so an unreachable
# remote makes the whole run INCONCLUSIVE — which would silently cost us the
# local bootstrap-wedge detection this timer exists for (EI-8892, the 3-day
# silent outage) every time a lid closes, and file an INCONCLUSIVE EI every
# DHT_STALE_H forever. The wrapper therefore ssh-preflights the remote and falls
# back to a LOCAL-ONLY run (logged, never filed) when it does not answer.
# Cross-host SUBSUMES the local check, so nothing is lost when the Mac IS up.
# A REACHABLE-but-failing remote is NOT skipped — that is the real P-302 signal.
#
# Set DHT_REQUIRE_CROSS_HOST=1 to make an unreachable remote INCONCLUSIVE
# instead of falling back (use that only while actively gating on P-302).
#
# WHICH remote is a property of a PARTICULAR dev box, not of the product, so it
# is NOT hardcoded here — a peer's rig has a different host, user and paths, and
# a home path baked into shipped source reds the identity-lint leg and freezes
# `main` for the whole fleet. The leading `-` makes it optional: a machine with
# no rig simply has no file and runs LOCAL-ONLY, which is the correct default.
#
# To enable the cross-host leg on a rig box, create that file with:
#   DHT_REMOTE_HOST=<user>@<rig-host>
#   DHT_REMOTE_CWD=<dir on the rig with hyperswarm/hyperdht resolvable>
#   DHT_REMOTE_NODE=<node binary on the rig with matching native deps>
# Use a DURABLE dir, never /tmp: macOS purges /tmp by access age, which would
# rot the leg into a permanent INCONCLUSIVE with no obvious cause.
EnvironmentFile=-%h/.papercusp/dht-liveness.env
# Run from an immutable per-invocation snapshot: a shared-tree edit mid-run cannot
# corrupt it (papercusp-script-snapshot.sh; census in systemd-script-snapshot.test.ts).
# The snapshot lives under $TMPDIR, so the script's repo root (which locates the
# probe .mjs and its node_modules) is pinned here.
Environment=PAPERCUSP_REPO_ROOT=%h/papercupai-workspace/papercusp
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/scripts/papercup-dht-liveness-check.sh

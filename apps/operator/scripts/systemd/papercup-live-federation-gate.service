[Unit]
Description=Live 2-peer federation gate (WI-261) — runs the two-instance smokes against the real packaged binary; catches the green-rig/red-binary class the hermetic suite structurally cannot

[Service]
Type=oneshot
WorkingDirectory=%h/papercupai-workspace/papercusp/papercusp-desktop
# SKIP_FROMREPO=0 as of 2026-07-27 (p2p-release leader su-e3b21, plan
# p2p-public-release-remaining-lanes-2026-07-16 D-016). This line USED to read
# SKIP_FROMREPO=1 with the note "the from-repo leg is expected-RED while WI-971 is open ...
# flip to 0 (or drop) when WI-971 lands". BOTH conditions that justified the skip are now
# closed, so the skip's own stated flip condition is met:
#   · WI-971 / WI-5628 (outbox drain never wired for joined/created hive harnesses) —
#     RESOLVED and live-verified TWICE on the real packaged binary under P-418/WI-5775:
#     two two-instance-hive-from-repo-smoke.sh runs (plain, and with this gate's exact
#     WITNESS_PROBE=1 + rekey flags) both OVERALL:PASS, incl. the bidirectional and
#     continuous post-join federation assertions WI-971 specifically closed.
#   · WI-5783 (the from-repo-WITNESS sub-probe: AK-ban write-plane drop failed live) —
#     RESOLVED: root-caused to two concurrent boot/merge-pass loops on the Hive owner's
#     instance (pot/home slug vs the owner's own member sub-harness slug) and fixed.
# Keeping the skip past that point was the release-gate analogue of shipping dark: the gate
# reported GREEN while silently not running this leg (first green 2026-07-27T02:00:39Z read
# "from-repo=SKIPPED from-repo-witness=SKIPPED"), and a skipped leg is not a green leg
# (D-015). This restores real coverage. If the leg reds, that is a genuine finding — triage
# it; do NOT re-set this to 1 to quiet it without recording why on the plan.
Environment=SKIP_FROMREPO=0
# This is a deliberately long scheduled job (up to 4h). It must yield its
# ordinary heavy slot when an exclusive dependency materializer arrives, or a
# 900s checkpoint drain can never outwait this 14400s holder (WI-41318/D-013).
# Coalescing is disabled here as well as in the script's direct-invocation
# wrapper: systemd invokes pc-heavy BEFORE the script can self-enrol.
Environment=PC_HEAVY_COALESCE=0
Environment=PC_HEAVY_PREEMPTIBLE=1
# systemd invokes pc-heavy BEFORE the gate's self-enrol wrapper, so duplicate
# the wrapper's safety defaults here.  The gate publishes the after-ready
# marker only after selftests/build/repack, immediately before content-matrix,
# removes it once that leg has a concrete verdict, and stays yieldable during
# preparation and the long from-repo/local-matrix tail. A materializer arriving
# during preparation gets ordinary preemption; retry only that exact typed
# preemption once after it drains. The generic 600s protection bound therefore
# covers the first real federation leg, not an arbitrarily slow build
# (EI-214124 / D-084).
Environment=PC_HEAVY_PREEMPT_AFTER_READY=1
Environment=PC_HEAVY_RETRY_PREEMPTIONS=1
# Join the same heavy-slot domain as agent verification. The script also
# self-enrols direct invocations; PC_HEAVY_BYPASS makes this wrapper one-shot.
# Both run from an immutable per-invocation snapshot: a shared-tree edit mid-run cannot
# corrupt them (papercusp-script-snapshot.sh; census in systemd-script-snapshot.test.ts).
# The launcher copies pc-heavy.sh AND the gate under $TMPDIR, so the gate can no longer
# find its checkout from its own path: both roots are pinned here (WI-10006358).
Environment=PAPERCUSP_REPO_ROOT=%h/papercupai-workspace/papercusp
Environment=DESKTOP_DIR=%h/papercupai-workspace/papercusp/papercusp-desktop
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/scripts/pc-heavy.sh -- /usr/bin/env bash bin/live-federation-gate.sh
# rebuild + repack + content-matrix (≈15-30 min) PLUS the local-matrix leg. Budget
# history: 2700s killed every local-matrix-day run at exactly 45 min (2026-07-17 00:30);
# raised to 7200s — which then killed runs 122147/142153/162155 (2026-07-18) at exactly
# 2h, mid restart_durability/reconnect_catchup (orders 80-85), so the suite's tail
# scenarios NEVER completed on a loaded box (failure paths burn their full 600s waits).
# 14400s bounds a wedged run at 4h while letting a slow-but-progressing one finish; the
# script's GREEN-freshness TTL + load gate keep real runs ~1/day regardless. The script
# traps TERM and emits "GATE: TERMINATED" so a kill is never silent.
TimeoutStartSec=14400
Nice=10
IOSchedulingClass=idle
# Measured runs peaked at 27.1-27.3G. Begin reclaim below that observed peak,
# retain bounded headroom for a healthy build, and add no swap to the host's
# already swap-heavy baseline. A cgroup kill is a nonzero service result, never
# a green gate verdict.
MemoryAccounting=yes
MemoryHigh=24G
MemoryMax=32G
MemorySwapMax=0

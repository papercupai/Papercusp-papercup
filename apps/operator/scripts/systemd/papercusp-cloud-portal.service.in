# Papercusp Cloud Portal backend user service template (EI-21983147886595945).
#
# This file is intentionally a template. deploy-cloud-portal.sh resolves the
# machine-specific portal checkout and Node binary, verifies the rendered unit,
# and installs it atomically in ~/.config/systemd/user. Keeping the app path out
# of this source file prevents a build-box user's home directory from becoming a
# shipped identity/path pin.
[Unit]
Description=Papercusp Cloud Portal backend on 127.0.0.1:@PORT@
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# The launcher announces READY=1 only after the bounded localhost HTTP probe
# receives 200. Its watchdog heartbeat is likewise conditional on a current
# successful probe, so `active` cannot outlive a blackholed backend.
Type=notify
NotifyAccess=all
WorkingDirectory=@PORTAL_ROOT@
# Runtime configuration is assembled by the boot launcher. The hosted env file
# contains only non-secret values and integration:NAME references; the launcher
# resolves those references in-process and exports ephemeral env slots to the
# standalone child. The Portal checkout's local .env.local is deliberately NOT
# sourced: it pins PORTAL_LOCAL_MODE=1 and carries plaintext local credentials.
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=@PORT@
Environment=PAPERCUSP_PORTAL_ROOT=@PORTAL_ROOT@
Environment=PAPERCUSP_PORTAL_START_WEB=@START_WEB@
Environment=PAPERCUSP_PORTAL_HOSTED_ENV_FILE=@HOSTED_ENV_FILE@
Environment=PAPERCUSP_PORTAL_OPERATOR_ENV_FILE=@OPERATOR_ENV_FILE@
Environment=PAPERCUSP_INTEGRATION_ROOT=@INTEGRATION_ROOT@
Environment=PORTAL_RUNTIME_ROOT=@RUNTIME_ROOT@
Environment=PORTAL_HEALTH_PATH=/
Environment=PORTAL_READINESS_TIMEOUT_MS=180000
Environment=PORTAL_READINESS_INTERVAL_MS=500
Environment=PORTAL_READINESS_REQUEST_TIMEOUT_MS=5000
Environment=PATH=@NODE_DIR@:%h/.local/bin:%h/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Generated releases live beside the checkout, not under it: a standalone trace
# must never copy its own release history into the next generation. start-web
# resolves that external current pointer once, then runs the immutable target.
ExecStart=@TSX@ @LAUNCHER@
# Restart=always, NOT on-failure (WI-10002337). The launcher treats a readiness
# -probe failure as an orderly shutdown and exits 0 — journal
# "portal_start_readiness_failed:watchdog-notify:portal_systemd_notify_exit_1"
# followed by sql-stopped / postgres-stopped, recorded by systemd as
# Result=success ExecMainStatus=0. Under on-failure that clean exit is NOT
# retried, so the single most likely boot fault for this unit was precisely the
# one its supervision could not recover from: measured 2026-09-21T23:14:41Z ->
# 2026-09-22T04:38:01Z, ~9h of app.papercusp.com front-door downtime ended only
# by a hand `systemctl start`, after which the same binary came up healthy.
# StartLimitIntervalSec=300 / StartLimitBurst=5 above still bound a crash loop.
Restart=always
RestartSec=3s
WatchdogSec=15s
TimeoutStartSec=240s
TimeoutStopSec=15s
KillSignal=SIGTERM
# The standalone launcher forks the traced server; the named unit must own and
# reap both processes instead of leaving a server child behind.
KillMode=control-group

[Install]
WantedBy=default.target

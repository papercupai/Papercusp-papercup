[Unit]
Description=Papercusp Postgres backup (pg_dump -Fd, parallel) — EI-10733
Documentation=https://papercusp.internal/issues/EI-10733
After=network-online.target
RequiresMountsFor=/mnt/cold-a/Backup/db-dumps
# The backup is the thing you need most when everything else is broken, so its
# failure must be VISIBLE. The old pg_dumpall leg failed silently behind a
# one-line "pg-5432 FAIL" for 30 days (EI-10733); db-backup.sh exits non-zero
# and healthcheck.sh asserts dump-content freshness from STATUS.json.
#
# OnFailure is a [Unit] key. It was previously in [Service], where systemd
# SILENTLY IGNORES it — so a failed backup raised no alarm at all. Moved to
# [Unit] 2026-07-14 (EI-10733 follow-up, su-a1a71).
OnFailure=papercusp-db-backup-alert.service

[Service]
Type=oneshot
# The scheduled guard returns EX_TEMPFAIL (75) when this cycle is intentionally
# deferred for lock/pressure contention. It is observable in ExecMainStatus,
# but must not fire the failure alert reserved for a real backup error.
SuccessExitStatus=75
Nice=19
IOSchedulingClass=idle
# WI-6554700010014799: dumps now live on /mnt/cold-a/Backup/db-dumps. The
# producer measures free space on its actual PGOUT and keeps the 120 GiB floor;
# moving the destination preserves that guard while the largest tier is staged.
#
# ⚠ KEEP IN SYNC with kopia-healthcheck.service, which sets the SAME var so the
# healthcheck asserts freshness against the tree the backup actually writes.
# Two units genuinely need it (different cgroups); a single ~/.config/environment.d
# definition would need `systemctl --user daemon-reexec`, which would disturb every
# other user unit on this box, so the per-unit form is deliberate.
Environment=PAPERCUSP_HOST_PG_DUMP_DIR=/mnt/cold-a/Backup/db-dumps
# The script skips an immediate calendar catch-up only after a recent successful
# scheduled run. Manual invocations do not set this marker.
Environment=PC_BACKUP_SCHEDULED=1
# One pg_dump worker keeps this large recurring producer in the scheduled
# low-impact lane. The script default remains 4 for deliberate one-off runs,
# but the hourly service must not recreate the four-worker MCP contention that
# motivated this admission boundary.
Environment=PC_BACKUP_JOBS=1
# A single serialized 4-job dump was measured at 34.25 GiB cgroup memory while
# the host reached memory PSI some/full 47.78%/34.88% (2026-08-23 12:08Z).
# Keep the hourly RPO and the shared guard, but admit the dump through the
# scheduled low-impact policy: unsafe host PSI or a held backup lock defers this
# cycle, while the guard's persisted staleness floor eventually admits a bounded
# run. MemoryMax is a last-resort ceiling; a failed dump leaves the previous
# validated artifact intact and the healthcheck alerts. This admission boundary
# matters because Nice/idle I/O lower the producer's priority but do not stop
# PostgreSQL from doing the dump work that competes with interactive MCP reads.
MemoryAccounting=yes
MemoryHigh=32G
MemoryMax=40G
MemorySwapMax=0
# Treat a hard-limit event as one failed atomic backup, not a partially alive
# pg_dump worker set. The next run's PGAPPNAME reaper remains defense in depth.
OOMPolicy=kill
# The dump atomically rewrites the same source tree Kopia snapshots. Hold the
# shared backup guard for the whole rewrite so the hourly dump and the
# 30-minute snapshot timer cannot saturate I/O together or capture different
# generations from the same run. The database dump is a scheduled producer and
# defers on unsafe pressure; its persisted staleness floor keeps the
# recovery-point objective bounded. Lock contention is a priority WAIT, not a
# deferral (--priority-on-contention, WI-10003884): with an hourly cadence and a
# 3600s staleness floor, deferring on contention skipped every other hour.
# Daily/manual producers retain wait mode.
# Snapshot both the guard and its nested backup script before starting. Bash
# reads long-running shell files lazily; an agent edit in the shared checkout
# must not change the byte stream of an in-flight backup (EI-22458080342999427).
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/kopia-backup-guard.sh --mode scheduled --label db-dump --no-restart-safe --priority-on-contention -- %h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-db-backup.sh

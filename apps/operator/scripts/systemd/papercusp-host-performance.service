[Unit]
Description=Papercusp shared-host CPU performance policy (WI-37533)
Documentation=file:///etc/systemd/system/papercusp-host-performance.sh
After=systemd-modules-load.service
# power-profiles-daemon applies its persisted profile at startup, and under
# amd-pstate-epp `balanced` writes scaling_governor=powersave to every policy.
# Unordered, it raced this unit's verified sweep at boot: the read-back failed
# mid-sweep, this unit failed, and the Postgres that Requires= it never started.
# Ordering only (no Wants=): our performance writes land last when it exists.
After=power-profiles-daemon.service
Before=postgresql@18-main.service
# WI-10004865: postgresql@18-main Requires= this unit (RequiredBy below), so a
# manual stop/restart of it propagates and restarts the shared Postgres. Refuse
# both; re-apply the policy with `systemctl reload` (ExecReload) instead.
RefuseManualStop=yes
ConditionPathExistsGlob=/sys/devices/system/cpu/cpufreq/policy*

[Service]
Type=oneshot
ExecStart=/etc/systemd/system/papercusp-host-performance.sh
ExecReload=/etc/systemd/system/papercusp-host-performance.sh
RemainAfterExit=yes
TimeoutStartSec=30
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
RequiredBy=postgresql@18-main.service

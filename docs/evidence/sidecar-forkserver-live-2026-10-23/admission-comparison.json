    "sourceRecipe": {
      "title": "Sidecar admission latency distribution (last 40 min)",
      "timeoutSec": 45,
      "script": "const r = await tools.logs.read({ unit: 'papercusp-bg-host.service', since: '2026-10-21 16:50:00 UTC', grep: \"'admission-ready': [0-9]|'child-close': [0-9]|'spawn-start': [0-9]\", limit: 1000, payloadTier: 'full' });\nconst es = r.entries||[];\nconst vals = { adm: [], close: [] };\nfor (const e of es) { const m = e.message||''; let x;\n  if ((x = m.match(/'admission-ready': (\\d+)/))) vals.adm.push(+x[1]);\n  if ((x = m.match(/'child-close': (\\d+)/))) vals.close.push(+x[1]); }\nconst q = (a)=>{ if(!a.length) return null; const s=[...a].sort((x,y)=>x-y); const p=(f)=>s[Math.min(s.length-1,Math.floor(f*s.length))]; return { n:s.length, p10:p(.1), p50:p(.5), p90:p(.9), max:s[s.length-1] }; };\nreturn { lines: es.length, truncated: r.truncated, admissionReady: q(vals.adm), childClose: q(vals.close), firstTs: es.map(e=>e.ts).sort()[0], lastTs: es.map(e=>e.ts).sort().pop() };"
    },

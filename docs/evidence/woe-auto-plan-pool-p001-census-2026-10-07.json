  "proposedContract": {
    "status": "Planned: current strict schemas do not yet support collection metadata.",
    "reuse": "Extend the existing TypedPropertyDefinitionSchema, list display, typed property writer, goal portfolio and GoalDetailPanel. No new membership table, scheduler, tool or dashboard.",
    "newDatatypeRationale": "Register one strict ordered-selection-policy datatype in the maintained datatype registry: the existing generic record constrains only object shape and does not enforce unique order/exclusion arrays. Use the existing builtin list for the second fixture.",
    "woe": {
      "worklist": {
        "datatype": "plan-ref-list",
        "default": [],
        "editable_by": "both",
        "collection": {
          "source": "active-workspace-plans",
          "policy": "worklist_policy",
          "order": "priority",
          "selectable": true,
          "defaultSelected": true
        }
      },
      "worklist_policy": {
        "datatype": "ordered-selection-policy",
        "default": {
          "order": [],
          "excluded": []
        },
        "editable_by": "owner"
      }
    },
    "portableNonPlanFixture": {
      "goal": "Tea tasting queue (private test fixture, no goal-name branching)",
      "tea_choices": {
        "datatype": "list",
        "default": [
          "mint",
          "chamomile",
          "rooibos"
        ],
        "editable_by": "both",
        "collection": {
          "source": "manual",
          "policy": "tea_policy",
          "order": "display",
          "selectable": true,
          "defaultSelected": true
        }
      },
      "tea_policy": {
        "datatype": "ordered-selection-policy",
        "default": {
          "order": [],
          "excluded": []
        },
        "editable_by": "owner"
      }
    },
    "reader": "One pure ordered-selection reader overlays persistent owner order/exclusions onto manual or approved-source candidates. Domain adapters apply existing runnability, approvals, dependencies and ownership AFTER selection. Keep dormant preferences when candidates disappear; discovery failure is unavailable, never a destructive empty-list update.",
    "cas": "Reuse existing versioned typed property writes and derived provenance. Agent source edits and reconciliation cannot change owner-only policy. Re-read policy revision at final NEW work boundaries; allow a current atomic step to finish safely.",
    "compatibility": "Preserve legacy worklist bytes/order, workspace-qualified reference identity and remembered choices through lifecycle churn. Nonconfigured/manual goals retain existing behavior. Automatic discovery never calls worklist attribution writers.",
    "admission": "Do not confuse owner exclusions with the dependency readiness floor: by-ID readiness overrides remain deliberate, while scoped selection/ownership controls remain authoritative. Lease-only functions are not work-item ownership writers."
  },

[Unit]
Description=Raise an alarm when the off-GCP estate mirror fails (WI-645563)
Documentation=file:%h/papercupai-workspace/papercusp/infra/estate-backup/RESTORE-RUNBOOK.md

[Service]
Type=oneshot
# Run from an immutable per-invocation snapshot: a shared-tree edit mid-run cannot
# corrupt it (papercusp-script-snapshot.sh; census in systemd-script-snapshot.test.ts).
# The script otherwise derives the repo from its own (snapshot) directory.
Environment=PC_REPO=%h/papercupai-workspace/papercusp
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/infra/estate-backup/pc-estate-mirror-alert.sh "pc-estate-mirror unit failed"

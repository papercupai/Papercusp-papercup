[Unit]
Description=Off-GCP mirror of the estate backups (WI-645563)
Documentation=file:%h/papercupai-workspace/papercusp/infra/estate-backup/RESTORE-RUNBOOK.md
# No After=network-online.target: that target is not-found in the USER manager, so the
# dependency was a silent no-op (WI-10006303). The script waits for connectivity itself.
# OnFailure is a [Unit] key. Putting it in [Service] is SILENTLY IGNORED by
# systemd — that mistake left the Postgres backup with no alarm at all for a
# while (EI-10733 follow-up). Keep it here.
OnFailure=pc-estate-mirror-alert.service

[Service]
Type=oneshot
# 75 = EX_TEMPFAIL: "no uplink yet, deferred" (the script arms pc-estate-mirror-retry.timer).
# Mapping it to success keeps OnFailure= (the fleet alarm) for REAL faults only.
SuccessExitStatus=75
# Pin the SERVICE ACCOUNT explicitly. Without this the script inherits whichever
# gcloud account happens to be active, which was the human `super@papercusp.com`
# user credential. On 2026-09-01 its refresh token needed reauthentication, the
# 01:18 run died with "cannot read <bucket> (gcloud auth?)", and for 33h the only
# surviving copy of the estate backups was the GCS bucket sitting in the SAME
# project as the VMs it protects -- exactly the single point of failure this
# mirror exists to remove. A human OAuth token expiring is not an incident, it is
# a certainty, so an unattended backup job must never depend on one. The service
# account is already credentialed on this host and can read the bucket.
Environment=CLOUDSDK_CORE_ACCOUNT=omp-vertex@active-alcove-504205-q3.iam.gserviceaccount.com
# The mirror is bulk I/O against a 92%-full disk shared with the whole fleet.
# It is never the urgent thing on this box, so it yields to everything.
Nice=15
IOSchedulingClass=idle
MemoryAccounting=yes
MemoryHigh=2G
MemoryMax=4G
# Budget = up to 30min waiting for an uplink (PC_ESTATE_MIRROR_NET_WAIT_SEC) plus the
# copy. A steady-state run fetches only the new day (~2 snapshots, a few minutes)
# because the walk stops at the newest KEEP per host (WI-10006308); a multi-day
# catch-up after an outage is ~2.5min per snapshot. A run past 90min is a fault
# worth alarming on rather than one to wait out.
TimeoutStartSec=90min
# Run from a private per-invocation snapshot (EI-22458080342999427): bash reads a
# script lazily by byte offset, so an edit landing in the shared tree mid-run could
# otherwise turn the running mirror into a different program. The snapshot holds
# only *.sh/*.mjs siblings, so the runbook source is pinned to the live tree.
Environment=PC_ESTATE_MIRROR_TOOLS_SRC=%h/papercupai-workspace/papercusp/infra/estate-backup
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/infra/estate-backup/pc-estate-mirror.sh mirror

[Install]
WantedBy=default.target

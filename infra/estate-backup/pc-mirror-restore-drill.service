[Unit]
Description=Restore drill FROM the off-GCP estate mirror (WI-645563)
Documentation=file:%h/papercupai-workspace/papercusp/infra/estate-backup/RESTORE-RUNBOOK.md
After=network-online.target docker.service
OnFailure=pc-estate-mirror-alert.service

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
# Pin the SERVICE ACCOUNT, same reason as pc-estate-mirror.service: the
# ExecStartPre below runs pc-estate-mirror.sh, which calls gcloud and would
# otherwise inherit whichever account happens to be active. When the human
# `super@papercusp.com` token needed reauthentication on 2026-09-01 the mirror
# died on exactly that call, and this drill was armed to fail the same way on its
# next fire -- which would have taken the RESTORE PROOF down with the copy, so
# both the backup and the evidence it is restorable would have been broken by one
# expiring credential.
Environment=CLOUDSDK_CORE_ACCOUNT=omp-vertex@active-alcove-504205-q3.iam.gserviceaccount.com
# Re-read every stored byte against its capture-time manifest BEFORE spending a
# restore on it. Bit rot is the failure a copy job can never see, because a copy
# job only ever looks at data it just wrote.
# Run from an immutable per-invocation snapshot: a shared-tree edit mid-run cannot
# corrupt it (papercusp-script-snapshot.sh; census in systemd-script-snapshot.test.ts).
# pc-estate-mirror.sh reads RESTORE-RUNBOOK.md beside itself (not a snapshotted sidecar).
Environment=PC_ESTATE_MIRROR_TOOLS_SRC=%h/papercupai-workspace/papercusp/infra/estate-backup
ExecStartPre=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/infra/estate-backup/pc-estate-mirror.sh verify
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/infra/estate-backup/pc-mirror-restore-drill.sh
TimeoutStartSec=90min

[Install]
WantedBy=default.target

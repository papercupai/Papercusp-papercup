# Phone app — LiveKit server config (plan phone-app-2026-08-30, P-002, D-002)
#
# TEMPLATE. Rendered by infra/phone-app/deploy.sh into
# ~/.config/papercusp-phone/livekit-server.yaml, with each placeholder below
# substituted. Never put a secret in this file — it is committed.
#
# Ports sit clear of the ~/Restart project's LiveKit (7880/7881/5060) on this host.

port: 7890

bind_addresses:
  - ""   # all interfaces

rtc:
  tcp_port: 7891
  # Single UDP mux port instead of a 10k range: one firewall rule, and it cannot
  # collide with the other project's 50000-60000 range.
  udp_port: 7892
  use_external_ip: true
  # Rendered by infra/phone-app/edge/edge-config.mjs livekit-interfaces. LiveKit hands the
  # same candidates to EVERY participant, so with the public media edge (D-025) only the
  # tunnel interface is listed: its traffic leaves through the cloud edge, use_external_ip's
  # per-interface STUN maps it to the edge's public IP, and a public client never receives a
  # LAN or loopback address (P-002 R-13, WI-10006708). Co-located services (the agent worker,
  # livekit-sip) reach that public candidate through the box-local DNAT the edge tunnel
  # installs. Without an edge, loopback + LAN keep co-located ICE off the home router's
  # hairpin NAT, which drops WebRTC consent keepalives.
  interfaces:
    includes:
${PHONE_LIVEKIT_INTERFACES}

# Coordination bus shared with livekit-sip. db 3 — db0/db1 are already in use on
# this host by other services.
redis:
  address: 127.0.0.1:6379
  db: 3

turn:
  enabled: true
  # TURN is TLS-only: never set udp_port. LiveKit would hand every client
  # turn:<node IP>:<udp_port>, and the node IP is the home address, which no
  # outside client can reach (WI-10006616). Clients with UDP reach the SFU
  # directly at its public edge candidate, and LiveKit issues its default public
  # STUN servers when no UDP TURN is configured.
  # This TURN server is public (D-024/D-025). livekit-server >= 1.12 refuses to
  # relay to private, loopback, link-local and multicast peers unless
  # allow_restricted_peer_cidrs lists them. Keep that default: never list the
  # box's LAN or loopback here. livekit-sip listens on every address, so a TURN
  # credential would reach SIP past the edge's carrier-only firewall. The relay
  # reaches the co-located SFU through its public edge candidate (WI-10006603).
  # One participant may hold at most this many relays (upstream default, >= 1.13.6).
  per_user_relay_allocation_limit: 12
  # Relay source ports, pinned (upstream default) because the box-local DNAT exempts them:
  # relay -> SFU traffic must leave through the edge, or the browser is handed the box's
  # LAN address as its mapped address (WI-10006708). Must equal TURN_RELAY_RANGE in
  # infra/phone-app/edge/edge-config.mjs; a test keeps them equal.
  relay_range_start: 30000
  relay_range_end: 40000
  # Hosted mode validates the hostname, certificate and key before rendering.
  # The public TCP/443 frontend must reach this TLS backend (default 7894).
${PHONE_TURN_TLS_CONFIG}

keys:
  ${PHONE_LIVEKIT_API_KEY}: ${PHONE_LIVEKIT_API_SECRET}

room:
  # A call is a room. Empty rooms should not linger.
  empty_timeout: 60
  departure_timeout: 20
  max_participants: 10

logging:
  level: info
  json: false

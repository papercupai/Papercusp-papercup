{
  "name": "@papercusp/plugin-sdk",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "pack:dist": "node scripts/pack-dist.mjs",
    "typecheck": "bash ../../scripts/pc-heavy.sh tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./iframe": {
      "types": "./src/iframe.ts",
      "import": "./src/iframe.ts",
      "default": "./src/iframe.ts"
    },
    "./provider": {
      "types": "./src/provider.ts",
      "import": "./src/provider.ts",
      "default": "./src/provider.ts"
    },
    "./provider-daemon": {
      "types": "./src/provider-daemon.ts",
      "import": "./src/provider-daemon.ts",
      "default": "./src/provider-daemon.ts"
    },
    "./provider-faults": {
      "types": "./src/provider-faults.ts",
      "import": "./src/provider-faults.ts",
      "default": "./src/provider-faults.ts"
    },
    "./provider-conformance": {
      "types": "./src/provider-conformance.ts",
      "import": "./src/provider-conformance.ts",
      "default": "./src/provider-conformance.ts"
    }
  },
  "dependencies": {
    "@papercusp/tooldef": "*"
  },
  "devDependencies": {
    "@papercusp/test-config": "*"
  },
  "peerDependencies": {
    "@types/node": ">=18",
    "@types/react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}

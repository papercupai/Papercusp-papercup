{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercuspai.com/schema/papercusp-plugin.schema.json",
  "title": "papercusp.json plugin manifest",
  "description": "Manifest for a Papercusp plugin. See packages/plugin-sdk for the runtime types.",
  "type": "object",
  "required": [
    "name",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference. Standard meta-keyword for editor LSP autocomplete. Operationally ignored by the loader."
    },
    "name": {
      "type": "string",
      "description": "Plugin id. Used as a directory name, Postgres schema prefix, event-bus topic prefix, and capability namespace.",
      "pattern": "^(@[a-z][a-z0-9_.-]{0,62}/)?[a-z][a-z0-9_.-]{2,62}$"
    },
    "version": {
      "type": "string",
      "description": "Semver version string.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "plugin",
        "pack",
        "template",
        "snapshot",
        "service",
        "theme",
        "harness"
      ],
      "description": "Distribution kind. Defaults to 'plugin'. 'pack' = a runtime-less code-tool pack: tools only — no ui/roles/routines/actions, runtime must stay js (tool-distribution-granularity-2026-06-05 D-001/D-004; replaces the never-used 'subagent-pack'). 'template' = a harness/project template (papercusp CLI). 'service'/'theme'/'harness'/'snapshot' = reserved/dormant — the loader treats every non-'pack' value as a default plugin. KEEP IN SYNC with the SDK `kind` union in packages/plugin-sdk/src/index.ts (EI-29)."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tool/pack/plugin/event deps this unit's tools + reactions need (tool-distribution-granularity D-003 plugin-to-tool deps; events axis: cupboard-public-release-2026-07-12 D-003). Validated at Cupboard install time against the host's pack catalog; same shape as a blueprint's dependencies.",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "packs": { "type": "array", "items": { "type": "string" } },
        "plugins": { "type": "array", "items": { "type": "string" } },
        "events": {
          "type": "array",
          "description": "Event-family deps (D-003). Resolved against provides.events across the pack catalog: an installed provider satisfies it, a Cupboard provider makes it installable, neither is a HARD failure like an unresolvable tool dep — unless optional:true (listen-if-present soft dep).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family"],
            "properties": {
              "family": { "type": "string", "minLength": 1, "description": "The provided event-family id this unit needs." },
              "optional": { "type": "boolean", "description": "optional:true = listen-if-present soft dep; an unresolvable optional event dep never blocks install." }
            }
          }
        }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Distribution-unit provisions surfaced to the Cupboard catalog + dependency resolver (cupboard-public-release-2026-07-12 D-003). Mirrors the provides_tools axis at the unit level. Pure DATA — a runtime-less kind:'pack' may declare provides.events (the pack-purity check allows it); actually emitting a family or reacting to one is runtime that rides a plugin.",
      "properties": {
        "events": {
          "type": "array",
          "description": "Awaitable event-key families this unit provides. Structural subset of the events:catalog EventCatalogEntry; the installed-tier catalog merge lifts these over the builtin registry with provenance.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "keyTemplate"],
            "properties": {
              "family": { "type": "string", "minLength": 1, "description": "Stable family id — the catalog lookup key + buildKey handle. Unique within provides.events." },
              "keyTemplate": { "type": "string", "minLength": 1, "description": "Exact key template with <param> placeholders; a no-param family is a literal key. Every <name> needs a matching params entry (validated at load)." },
              "params": {
                "type": "array",
                "description": "Placeholders the keyTemplate interpolates, in order.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "required", "describe"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "description": "Placeholder name as it appears in the template." },
                    "required": { "type": "boolean", "description": "Must a caller supply it? An omitted optional param collapses its :<name> segment." },
                    "describe": { "type": "string", "description": "One line for the catalog + sugar arg docs." }
                  }
                }
              },
              "describe": { "type": "string", "description": "What firing this key MEANS (one line), for the catalog." }
            }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "description": "Integration provider descriptor (generalized-integrations D-006). The plugin's adapter implements describe/syncPage/invoke; the host owns connections, credentials, cursors and grants, and providers reach the network only through host.fetch within egressHosts.",
      "required": ["id", "contractVersion", "datatypes", "capabilities", "egressHosts"],
      "allOf": [{
        "if": { "required": ["oauth"], "properties": { "oauth": { "required": ["instance"], "properties": { "instance": { "const": true } } } } },
        "then": { "properties": { "egressHosts": { "maxItems": 0 } } },
        "else": { "properties": { "egressHosts": { "minItems": 1 } } }
      }],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "contractVersion": { "type": "integer", "minimum": 1 },
        "displayName": { "type": "string" },
        "datatypes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sync": { "type": "boolean", "description": "Whether inbound sync is supported. Omitted means true; false declares a write-only provider that the host does not poll." },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "rateBudget": {
          "type": "object", "additionalProperties": false,
          "description": "Vendor budget declarations with independent dated evidence. Admission and retry policy remain host-owned.",
          "required": ["verifiedAt", "sources"],
          "properties": {
            "verifiedAt": {
              "type": ["string", "null"],
              "description": "Actual ISO calendar date, including Gregorian leap-year validation; independent of the provider API-contract date.",
              "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
            },
            "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
            "requestsPerMinute": { "type": "number", "exclusiveMinimum": 0 },
            "quotaUnitsPerDay": { "type": "number", "exclusiveMinimum": 0 },
            "budgetHeaders": { "type": "array", "items": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" } },
            "notes": { "type": "string", "minLength": 1 },
            "buckets": {
              "type": "object", "minProperties": 1,
              "propertyNames": { "minLength": 1 },
              "additionalProperties": {
                "type": "object", "additionalProperties": false,
                "required": ["appliesTo", "perDay", "unit"],
                "properties": {
                  "appliesTo": { "type": "string", "minLength": 1 },
                  "perDay": { "type": "number", "exclusiveMinimum": 0 },
                  "unit": { "enum": ["calls", "units"] },
                  "verbs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                  "notes": { "type": "string", "minLength": 1 }
                }
              }
            },
            "dynamicQuota": {
              "type": "object", "additionalProperties": false,
              "required": ["formula", "driver", "assumedDailyFloor"],
              "properties": {
                "formula": { "type": "string", "minLength": 1 },
                "driver": { "type": "string", "minLength": 1 },
                "usageHeader": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
                "assumedDailyFloor": { "type": "number", "exclusiveMinimum": 0 },
                "throttleCodes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                "retryExtendsBlock": { "type": "boolean" }
              }
            }
          },
          "allOf": [{ "if": { "properties": { "verifiedAt": { "type": "string" } } }, "then": { "properties": { "sources": { "minItems": 1 } } } }]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verifiedAt", "sources"],
          "description": "Dated API-contract evidence, not account consent or live acceptance. Capability attestations must name capabilities declared by this descriptor (checked by SDK validation).",
          "properties": {
            "verifiedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
            "capabilities": {
              "type": "object",
              "additionalProperties": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
            },
            "blockedOn": { "type": "string", "minLength": 1 }
          },
          "allOf": [{
            "if": { "properties": { "verifiedAt": { "type": "string" } } },
            "then": { "properties": { "sources": { "minItems": 1 } } }
          }]
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorizeUrl", "tokenUrl", "scopes"],
          "properties": {
            "instance": { "const": true },
            "authorizeUrl": { "type": "string" },
            "tokenUrl": { "type": "string" },
            "scopes": { "type": "array", "items": { "type": "string" } },
            "scopeSeparator": { "type": "string", "enum": [" ", ","] },
            "clientIdParameter": { "type": "string", "enum": ["client_id", "client_key"] },
            "tokenEndpointAuthMethod": { "type": "string", "enum": ["client_secret_post", "client_secret_basic"] },
            "userAgentRequired": { "const": true },
            "refreshPolicy": { "type": "string", "enum": ["refresh-token", "reauthorize"] },
            "pkce": { "type": "boolean" },
            "clientRegistrationRef": { "type": "string" },
            "credentialGroup": { "type": "string" },
            "personalAccountDomains": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$" }
            },
            "legacyCredentialPlugins": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
            },
            "resourceToken": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "hosts", "collectionField", "idField", "tokenField", "configKey"],
              "description": "Host-only account-to-resource credential exchange. Selects the resource from persisted source config and never exposes its token to the provider.",
              "properties": {
                "url": { "type": "string" },
                "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "collectionField": { "type": "string", "minLength": 1 },
                "idField": { "type": "string", "minLength": 1 },
                "tokenField": { "type": "string", "minLength": 1 },
                "configKey": { "type": "string", "minLength": 1 },
                "nextUrlField": { "type": "string", "minLength": 1 },
                "permissions": {
                  "type": "object", "additionalProperties": false, "required": ["field", "required"],
                  "properties": {
                    "field": { "type": "string", "minLength": 1 },
                    "required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            },
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "idField"],
              "properties": {
                "url": { "type": "string" },
                "idField": { "type": "string" },
                "displayNameField": { "type": "string" },
                "method": { "type": "string", "enum": ["GET", "POST"] },
                "body": { "type": "string" }
              }
            }
          }
        },
        "egressHosts": { "type": "array", "items": { "type": "string" } },
        "serviceCredentials": {
          "type": "array",
          "description": "Host-held service credentials the provider needs by reference (D-018), e.g. a Pub/Sub service account. Each ref is resolved by the host and injected by host.fetch only for its listed hosts, which must also be in egressHosts.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "hosts"],
            "properties": {
              "ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
              "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "configSchema": { "type": "object" },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "description": "Setup the owner performs by hand on the provider's Integrations card (cupboard-distributable-integrations-2026-10-10). Pure data: the host renders it, checks values, stores them host-side and never returns them.",
          "properties": {
            "session": {
              "type": "object", "additionalProperties": false,
              "required": ["url", "refreshUrl", "parameters", "hosts", "accessTokenField", "refreshTokenField", "maxAgeSeconds", "identity"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://" },
                "refreshUrl": { "type": "string", "pattern": "^https://" },
                "parameters": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
                "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "accessTokenField": { "type": "string", "minLength": 1 },
                "refreshTokenField": { "type": "string", "minLength": 1 },
                "activeField": { "type": "string", "minLength": 1 },
                "maxAgeSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
                "identity": { "type": "object", "additionalProperties": false, "required": ["idField"], "properties": {
                  "idField": { "type": "string", "minLength": 1 }, "displayNameField": { "type": "string", "minLength": 1 },
                  "credentialKey": { "type": "string", "minLength": 1 }
                } }
              }
            },
            "credentials": {
              "type": "array",
              "minItems": 1,
              "description": "Paste-a-secret fields (P-001). Shown masked; each value must fully match `pattern`; stored next to OAuth tokens; injected by host.fetch only for `hosts` (which must be in egressHosts) or read by host-held ingress. A descriptor never carries a value.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label"],
                "properties": {
                  "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
                  "label": { "type": "string", "minLength": 1 },
                  "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "help": { "type": "string" },
                  "helpUrl": { "type": "string" },
                  "placeholder": { "type": "string" },
                  "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "auth": {
                    "type": "object", "additionalProperties": false, "required": ["header", "scheme"],
                    "properties": {
                      "header": { "enum": ["authorization", "api-key", "x-api-key"] },
                      "scheme": { "enum": ["bearer", "raw", "bot"] }
                    }
                  },
                  "perPrincipal": {
                    "type": "boolean",
                    "description": "Each person pastes their own value; the host uses it only for that person's calls (e.g. a user token for live search)."
                  }
                }
              }
            },
            "appRegistration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["createUrl"],
              "description": "The vendor app the owner creates before connecting (P-002). The card offers a Create app link to `createUrl`, with `{definition}` replaced by the URL-encoded JSON of `definition`, and a Copy definition fallback. Never carries a credential.",
              "properties": {
                "createUrl": { "type": "string", "anyOf": [{ "pattern": "^https://" }, { "pattern": "^/(?!/)[^\\s\\\\#]*$" }] },
                "definition": { "type": "object" },
                "docsUrl": { "type": "string", "pattern": "^https://" },
                "copyHint": { "type": "string" }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["socket"],
          "description": "Inbound delivery the host holds open per connected source (cupboard-distributable-integrations P-003, D-009). The host opens the socket with the stored setup credential named by `credential`, acks each envelope by echoing `ackField`, reconnects on a `reconnect` value, and hands each envelope to the provider's ingress.normalize capability. Never carries a credential.",
          "properties": {
            "socket": {
              "type": "object",
              "additionalProperties": false,
              "required": ["credential", "open"],
              "properties": {
                "credential": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
                "open": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["url", "urlField"],
                  "properties": {
                    "url": { "type": "string", "pattern": "^https://" },
                    "method": { "type": "string", "enum": ["GET", "POST"] },
                    "urlField": { "type": "string", "minLength": 1 }
                  }
                },
                "ackField": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
                "reconnect": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "values"],
                  "properties": {
                    "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
                    "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                  }
                },
                "immediate": {
                  "type": "object",
                  "description": "Envelopes whose field matches one of values are normalized at once instead of waiting behind the serialized chain (e.g. an interaction that must open a form within the vendor's window).",
                  "additionalProperties": false,
                  "required": ["field", "values"],
                  "properties": {
                    "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
                    "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            }
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identityProvider"],
          "properties": {
            "identityProvider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
            "containers": {
              "type": "boolean",
              "description": "syncPage emits container membership pages (each container with its complete members), and records carry the container as their read scope."
            }
          }
        },
        "defaultDestinations": {
          "type": "object",
          "description": "Destination policy a newly connected source starts with: datatype -> destinations (record, event, document). Keys must be declared datatypes; the host never overwrites a policy the owner set.",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["record", "event", "document"] }
          }
        },
        "push": {
          "type": "object",
          "additionalProperties": false,
          "description": "Host-verified push: handshake or host-held OAuth app secret, optional GET verification, and wake or ingress.normalize record admission.",
          "required": ["signature"],
          "properties": {
            "handshake": {
              "type": "object",
              "additionalProperties": false,
              "required": ["header"],
              "properties": { "header": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } }
            },
            "signature": {
              "type": "object",
              "additionalProperties": false,
              "required": ["header", "algorithm", "encoding"],
              "properties": {
                "header": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
                "algorithm": { "type": "string", "enum": ["hmac-sha256"] },
                "encoding": { "type": "string", "enum": ["hex"] },
                "prefix": { "type": "string", "pattern": "^[A-Za-z0-9=_-]{1,32}$" },
                "oauthClientSecret": { "type": "boolean" }
              }
            },
            "delivery": { "type": "string", "enum": ["wake", "normalize"] },
            "verification": {
              "type": "object", "additionalProperties": false,
              "required": ["modeParam", "modeValue", "tokenParam", "challengeParam", "credentialRef"],
              "properties": {
                "modeParam": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
                "tokenParam": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
                "challengeParam": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
                "modeValue": { "type": "string", "minLength": 1, "maxLength": 100 },
                "credentialRef": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "triggerPack": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pure-data workflow graph (external-triggers D-014/D-015/P-012): N plan|recipe targets, single-target bindings, and event-stitched internal edges. It rides kind:'plugin', never executable-tool kind:'pack'. Installation exposes the graph but never arms it.",
      "required": ["inputs", "targets", "bindings", "edges"],
      "properties": {
        "inputs": {
          "type": "object",
          "description": "Workflow-level declared input JSON Schema. A string (or array-of-strings) property may declare `x-options: { capability, args? }` so settings forms list its choices from a connected provider that declares that `<domain>.<verb>` capability. Credential/channel install fields retain their per-field share semantics in configSchema."
        },
        "defaultStormPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRuns": { "type": "integer", "minimum": 1 },
            "windowSeconds": { "type": "integer", "minimum": 1 }
          },
          "description": "Pack-wide storm-policy default; a binding may override it."
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "description": "Graph target nodes. Stored kinds are plan|recipe; a UI tool call is a one-step recipe.",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "path", "inputSchema"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": { "const": "plan" },
                  "path": { "type": "string", "minLength": 4 },
                  "inputSchema": { "type": "object" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "ref", "argsSchema"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": { "const": "recipe" },
                  "ref": { "type": "string", "minLength": 1 },
                  "revision": { "type": "integer", "minimum": 1 },
                  "argsSchema": { "type": "object" }
                }
              }
            ]
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "description": "Each binding invokes exactly one target. Chains use internal-source bindings plus edges, never a steps orchestrator.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "target"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind"],
                    "description": "Provider-pinned (sourceKind, pattern ext:<sourceKind>:…) or portable (datatype + capabilities, pattern ext:*:…; bound at install to an installer-chosen local source whose provider produces the datatype).",
                    "oneOf": [
                      { "required": ["sourceKind"], "not": { "required": ["datatype"] } },
                      { "required": ["datatype"], "not": { "required": ["sourceKind"] } }
                    ],
                    "properties": {
                      "kind": { "const": "external" },
                      "sourceKind": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
                      "datatype": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
                      "capabilities": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 },
                        "uniqueItems": true
                      },
                      "oauthField": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "event"],
                    "properties": {
                      "kind": { "const": "internal" },
                      "event": { "type": "string", "enum": ["binding-run-completed", "plan-completed"] }
                    }
                  },
                  {
                    "deprecated": true,
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Deprecated and rejected by trigger-pack semantic validation: trigger packs do not consume schedules. Use a manual binding and arm the instantiated plan with plans:set-schedule followed by plans:arm-schedule.",
                    "required": ["kind", "scheduleRef"],
                    "properties": {
                      "kind": { "const": "schedule" },
                      "scheduleRef": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind"],
                    "properties": { "kind": { "const": "manual" } }
                  }
                ]
              },
              "target": { "type": "string", "minLength": 1 },
              "eventPattern": { "type": "string", "minLength": 1 },
              "filter": { "type": "object" },
              "mapping": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "type": "string", "enum": ["type-match", "fields", "payload-context"] },
                  "fields": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              },
              "stormPolicy": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxRuns": { "type": "integer", "minimum": 1 },
                  "windowSeconds": { "type": "integer", "minimum": 1 }
                }
              },
              "retry": {
                "type": "object",
                "additionalProperties": false,
                "required": ["maxAttempts", "onExhausted"],
                "properties": {
                  "maxAttempts": { "type": "integer", "minimum": 1 },
                  "backoffSeconds": { "type": "integer", "minimum": 1 },
                  "onExhausted": { "const": "dead-letter" }
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "description": "Internal event edges between bindings. One-node v1 packs declare an empty array.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "event", "correlation"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "event": { "type": "string", "enum": ["binding-run-completed", "plan-completed"] },
              "correlation": { "const": "inherit" }
            }
          }
        }
      }
    },
    "papercusp": {
      "type": "string",
      "description": "Semver range against the runtime version (PAPERCUSP_RUNTIME_VERSION)."
    },
    "protocol": {
      "type": "string",
      "description": "Semver range against the plugin wire protocol version. Independent of the runtime release cycle so hooks can evolve without bumping the whole runtime."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Declarative permissions. Format: namespace:action[:resource]. The host AND-checks declared capabilities against the user-granted set."
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "MCP tool declarations."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Action declarations bound at init() time."
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dashboardTabs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sidebarItems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ui": {
      "type": "array",
      "description": "UI surface contributions. Each entry is a top-level pane/tab a host renders. v1 hosts: React (in-bundle component) and iframe (sandboxed) on desktop; tui-pane in the pui (terminal).",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "react",
              "iframe",
              "tui-pane"
            ],
            "description": "react = in-bundle component (default for back-compat). iframe = sandboxed iframe (Batch H). tui-pane = a terminal pane the pui opens via zellij, running `command` (revive-plugin-system D-002)."
          },
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "iframeEntry": {
            "type": "string",
            "description": "Relative path to the iframe HTML entry. Required when type='iframe'."
          },
          "iframeNavigateOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Origins the iframe is allowed to top-navigate to. Honored by the iframe:navigate cap gate."
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "argv to run in the pui's zellij pane. Required when type='tui-pane'. command[0] must be a PATH basename (or absolute path) the plugin holds `compute:exec:<command[0]>` for; runs with cwd = the plugin's install dir. Example: [\"sh\", \"render.sh\"]."
          }
        },
        "required": [
          "slug",
          "label"
        ]
      }
    },
    "runtime": {
      "type": "object",
      "description": "Optional runtime descriptor. Defaults to {kind:'js'} (existing JS plugins). 'wasm' loads a wasm32-wasip2 component artifact via @papercusp/plugin-loader/wasm. 'daemon' loads a long-running stdio JSON-RPC peer via @papercusp/plugin-loader/daemon.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "js",
            "wasm",
            "daemon"
          ]
        },
        "wasmPath": {
          "type": "string",
          "description": "Relative path from manifest dir to the .wasm artifact. Required when kind='wasm'."
        },
        "daemonCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "argv for the daemon binary. Required when kind='daemon'."
        },
        "daemonRestart": {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "never",
                "on-failure",
                "always"
              ]
            },
            "maxRestarts": {
              "type": "integer",
              "minimum": 0
            },
            "backoffMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "memoryBudgetMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Hard cap for WASM linear-memory growth (MiB). Default 64 (Batch G4)."
        },
        "concurrency": {
          "type": "string",
          "enum": [
            "serial",
            "parallel"
          ],
          "description": "Action-invocation concurrency. WASM defaults to 'serial' (mpsc actor pattern); daemon defaults to 'parallel'."
        }
      },
      "required": [
        "kind"
      ]
    },
    "apiRoutes": {},
    "routines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reactions": {
      "description": "Declarative event-reaction rules (plugin-system-hive-port D-003): when trigger `on` settles, fire one of THIS plugin's tools through normal dispatch. Manifest rules are the declarative subset — `when` is a data-match object, `args` a static object; function forms need an entry-point plugin. Each `on` trigger requires an `events:listen:<on>` capability.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "on": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
            ]
          },
          "when": { "type": "object" },
          "fire": { "type": "string", "minLength": 1 },
          "args": { "type": "object" },
          "onlyOnSuccess": { "type": "boolean" },
          "capability": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "on", "fire"],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object"
    },
    "configSchema": {
      "type": "object"
    },
    "uiSchema": {
      "type": "object"
    },
    "schema": {
      "type": "object"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "configFiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "requiresTemplateKinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forkedFrom": {
      "type": "object"
    },
    "publishedAt": {
      "type": "string"
    },
    "publishedBy": {
      "type": "string"
    },
    "tierMap": {
      "type": "object"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name or emoji shown next to the plugin in catalog UI."
    },
    "bundled": {
      "type": "boolean",
      "description": "Build-pipeline only \u2014 DO NOT set in your plugin's manifest. Operator install stamps this on plugins that ship pre-installed; capture excludes bundled plugins from snapshot.plugins[]. Lint rejects author-set values. (rev3 plan G+5 / A10)"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Plugin-author opt-in for files in the per-plugin work-dir that should travel with snapshots. Default: work-dir stripped on capture. (rev3 plan G+4)",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Path relative to plugin work-dir root. Globs supported (minimatch)."
              },
              "redact": {
                "type": "string",
                "enum": [
                  "strip"
                ],
                "description": "When 'strip': include path as zero-byte placeholder (vs. absent which means 'never existed')."
              }
            }
          }
        }
      }
    },
    "hidden": {
      "type": "boolean",
      "description": "Hide from catalog surfaces; complements harness_shared.hidden_plugins."
    },
    "distribution": {
      "type": "string",
      "enum": ["bundled", "cupboard"],
      "description": "How a running app obtains the package. 'cupboard': loads only from a Cupboard install; the bundled plugin root never loads it (D-015). Absent = bundled."
    },
    "hiddenReason": {
      "type": "string"
    },
    "publisher": {
      "type": "string",
      "description": "Publisher slug (often === author or scope)."
    },
    "pluginVersionPinned": {
      "deprecated": true,
      "description": "DEPRECATED v1: use `versionPin` instead. Reader still accepts this for back-compat. true \u2192 equivalent to `versionPin.mode: 'exact'`; false \u2192 equivalent to `versionPin.mode: 'semver'`. Schema previously allowed string here; that's no longer used (was a band-aid for in-flight first-party plugins \u2014 replaced by `versionPin` cleanly).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "versionPin": {
      "description": "v2 (rev3 plan G+2) per-plugin version-pinning policy. Replaces `pluginVersionPinned`. mode='semver' for JS plugins (default), 'exact' for legacy strict pinning, 'hash' for content-addressed (WASM/daemon default). allowOverride lets marketplace-flagged security patches supersede pinned versions; defaults to 'security-patch'.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "semver",
            "exact",
            "hash"
          ]
        },
        "allowOverride": {
          "type": "string",
          "enum": [
            "security-patch",
            "always",
            "never"
          ]
        }
      }
    },
    "hotReload": {
      "description": "Hot-reload state preservation opt-in. When `preserveState: true`, the host calls `getStateForReload` before unload and `restoreFromReload(state)` on the next init. State must be JSON-serialisable and \u2264 64 KiB.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserveState": {
          "type": "boolean"
        }
      }
    },
    "kvQuota": {
      "description": "Optional override of the default ctx.kv quotas. maxBytesPerKey defaults to 10 KiB; maxBytesPerPlugin defaults to 1 MiB.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytesPerKey": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxBytesPerPlugin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        }
      }
    },
    "provision": {
      "type": "object",
      "description": "Cloudflare/infra provisioning hints."
    },
    "oauth": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "OAuth provider declarations consumed by ctx.oauth."
    },
    "main": {
      "type": "string",
      "description": "Node-style entry-point hint; CLI also probes index.{cjs,js,mjs,ts}."
    },
    "config": {
      "type": "object",
      "description": "Default config values. configSchema describes the shape; this provides defaults."
    },
    "_legacyExtras": {
      "type": "object",
      "description": "Escape hatch for forward-compatible extras the schema doesn't know yet."
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plugin slugs this plugin requires. Used by lock-resolve to build a dependency graph (CLI: papercusp install, papercusp plugin install). Each entry is a slug like \"@org/dep-plugin\"."
    },
    "recommends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plugin slugs this plugin recommends (soft dependencies \u2014 surfaced to the user during install but not auto-installed). Same shape as requires."
    },
    "defaultConfig": {
      "type": "object",
      "description": "Initial config values written to ~/.papercusp/plugin-configs/<slug>.json on first install. Must conform to configSchema if both are declared. Used by papercusp plugin init seeding."
    }
  }
}

+const writeFiles = async (indexId, options) => {
+    // The backend's WriteFiles response can precede completion of its buffered
+    // filesystem writes. close() then kills it, leaving 32KiB/64KiB asset prefixes.
+    // Get the same generated bytes through the supported API and await Node's
+    // writes before resolving, so closing the service cannot interrupt output.
+    const result = await getFiles(indexId);
+    if (result.errors.length) return { errors: result.errors };
+    const outputPath = resolve(options?.outputPath ?? "pagefind");
+    for (const file of result.files) {
+        const target = resolve(outputPath, file.path);
+        await mkdir(dirname(target), { recursive: true });
+        await writeFile(target, file.content);
+    }
+    return { errors: [], outputPath };
+};
 
